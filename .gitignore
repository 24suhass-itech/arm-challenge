# Whitelist: only the new models (disease model + pest model), their training code, results and the report
# are published. Everything else (old models, datasets, caches) stays local.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/disease_model/
!/pest_model/
!/docs/
!/advisor/
!/.gitattributes
!/deploy/
!/test images/

# old models and old experiments (never pushed)
/checkpoints/
/mixed_finetuning/
/six_dataset_training/
/unified_training/
/finetuning/
/results/
/splits/
/datasets/

# large / regenerable / machine-specific files inside the new folders
**/cache/
**/__pycache__/
**/*_last.pth
**/index.csv
**/*log*.txt
**/train_err.txt

# Llama weights and exported .pte (licensed by Meta, >1 GB; created by advisor/export_llama.py)
/advisor/llama/
# IndicTrans2 translator weights (1.1 GB; downloaded from Hugging Face, see advisor/README)
/advisor/translator/
/advisor/*log*.txt
/advisor/export_err.txt

# Raspberry Pi bundle (built by deploy/raspberry_pi/make_bundle.py)
/KrishiRakshak_Pi/
